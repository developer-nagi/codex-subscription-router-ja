root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{go,js,cjs,json,md,ps1,py,yml,yaml}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.ps1]
# Windows PowerShell 5.1 reads UTF-8 without a BOM as ANSI.
charset = utf-8-bom
